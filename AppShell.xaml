<?xml version="1.0" encoding="utf-8" ?>
<!-- AppShell.xaml – Flyout + Tab bar shell used after login -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Le2me.Views"
       xmlns:controls="clr-namespace:Le2me.Controls"
       x:Class="Le2me.AppShell"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="{StaticResource PrimaryGreen}"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="{StaticResource PrimaryGreen}"
       Shell.TabBarUnselectedColor="Gray"
       FlyoutBehavior="Flyout"
       FlyoutWidth="280">

    <!-- ── Sidebar (Flyout) ───────────────────────────────────── -->
    <Shell.FlyoutContent>
        <controls:ProfileDrawer />
    </Shell.FlyoutContent>

    <!-- ── Bottom Tab Bar ─────────────────────────────────────── -->
    <TabBar>

        <!-- Home -->
        <ShellContent
            Title="Home"
            Icon="tab_home.png"
            Route="HomePage"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <!-- AI Chat -->
        <ShellContent
            Title="AI Chat"
            Icon="tab_chat.png"
            Route="ChatAIPage"
            ContentTemplate="{DataTemplate views:ChatAIPage}" />

        <!-- Explore -->
        <ShellContent
            Title="Explore"
            Icon="tab_explore.png"
            Route="ExplorePage"
            ContentTemplate="{DataTemplate views:ExplorePage}" />

        <!-- Add Post -->
        <ShellContent
            Title="Add Post"
            Icon="tab_add.png"
            Route="CreatePostPage"
            ContentTemplate="{DataTemplate views:CreatePostPage}" />

    </TabBar>

    <!-- ── Routes registered for push navigation ─────────────── -->
</Shell>
