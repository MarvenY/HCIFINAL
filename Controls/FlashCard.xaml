<?xml version="1.0" encoding="utf-8" ?>
<!--
    FlashCard.xaml
    Hero card shown in the home page carousel.
    CardType: "welcome" | "explore" | "chat"
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Le2me.Controls.FlashCard"
             x:Name="Root">

    <Grid>
        <!-- Background gradient -->
        <BoxView x:Name="BackgroundBox"
                 CornerRadius="16"
                 Color="{StaticResource PrimaryGreen}" />

        <!-- Content -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="10"
                             Padding="20">

            <Label x:Name="IconLabel"
                   FontSize="56"
                   HorizontalOptions="Center" />

            <Label x:Name="TitleLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="SubtitleLabel"
                   FontSize="14"
                   TextColor="#E8F5E9"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
