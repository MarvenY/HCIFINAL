<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Le2me</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App info -->
    <ApplicationTitle>Le2me</ApplicationTitle>
    <ApplicationId>com.example.le2me</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.8.2</ApplicationDisplayVersion>

    <!-- Windows only -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- App icon & splash image resources -->
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" Condition="Exists('Resources\Images')" />
    <MauiFont Include="Resources\Fonts\*" Condition="Exists('Resources\Fonts')" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
    <!-- Firebase / Firestore – add real SDK references here when ready -->
    <!-- <PackageReference Include="Plugin.Firebase.Auth" Version="2.0.11" /> -->
    <!-- <PackageReference Include="Plugin.Firebase.Firestore" Version="2.0.11" /> -->
    <!-- <PackageReference Include="Plugin.Firebase.Storage" Version="2.0.11" /> -->
  </ItemGroup>

</Project>
