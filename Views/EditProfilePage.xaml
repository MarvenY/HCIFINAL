<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Le2me.ViewModels"
             x:Class="Le2me.Views.EditProfilePage"
             Title="Edit Profile">

    <ContentPage.BindingContext>
        <vm:EditProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="16">

            <Label Text="Edit Profile"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreen}" />

            <!-- ── Username ─────────────────────────────────── -->
            <Label Text="Username" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Entry Text="{Binding Username}"
                       Placeholder="New username"
                       Style="{StaticResource FormEntry}" />
            </Frame>
            <Button Text="Save Username"
                    Command="{Binding SaveUsernameCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" />

            <!-- ── Divider ──────────────────────────────────── -->
            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,8" />

            <!-- ── Choose Avatar ────────────────────────────── -->
            <Label Text="Choose Profile Picture"
                   FontSize="16"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Avatars}"
                            SelectionMode="Single"
                            HeightRequest="200">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Frame CornerRadius="40"
                               HeightRequest="80" WidthRequest="80"
                               Padding="0"
                               IsClippedToBounds="True"
                               HasShadow="True"
                               BorderColor="{StaticResource PrimaryGreen}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditProfileViewModel}}, Path=SelectAvatarCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Image Source="{Binding .}" Aspect="AspectFill" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── Divider ──────────────────────────────────── -->
            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,8" />

            <!-- ── Reset Password ────────────────────────────── -->
            <Label Text="Security" FontSize="16" FontAttributes="Bold" />
            <Button Text="Send Password Reset Email"
                    Command="{Binding ResetPasswordCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource DangerButton}" />

            <!-- ── Feedback ──────────────────────────────────── -->
            <Label Text="{Binding SuccessMessage}"
                   TextColor="{StaticResource PrimaryGreen}"
                   FontSize="14"
                   FontAttributes="Bold"
                   IsVisible="{Binding SuccessMessage, Converter={x:StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={x:StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryGreen}"
                               HorizontalOptions="Center" />

            <BoxView HeightRequest="40" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
