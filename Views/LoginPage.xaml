<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Le2me.ViewModels"
             x:Class="Le2me.Views.LoginPage"
             Title="Sign In"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <!-- Full-page scrollable layout -->
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="24,60,24,24">

            <!-- ── Header ──────────────────────────────────────────── -->
            <VerticalStackLayout Grid.Row="0"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Margin="0,0,0,40">

                <Frame CornerRadius="50"
                       HeightRequest="100" WidthRequest="100"
                       BackgroundColor="{StaticResource PrimaryGreen}"
                       Padding="0"
                       HorizontalOptions="Center"
                       HasShadow="True">
                    <Label Text="🍽️"
                           FontSize="50"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <Label Text="Le2me"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryGreen}"
                       HorizontalOptions="Center" />

                <Label Text="Sign in to continue"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ── Form ───────────────────────────────────────────── -->
            <VerticalStackLayout Grid.Row="1" Spacing="16">

                <!-- Email -->
                <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="✉️" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding Email}"
                               Placeholder="Email address"
                               Keyboard="Email"
                               Style="{StaticResource FormEntry}" />
                    </Grid>
                </Frame>

                <!-- Password -->
                <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔒" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding Password}"
                               Placeholder="Password"
                               IsPassword="True"
                               Style="{StaticResource FormEntry}" />
                    </Grid>
                </Frame>

                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={x:StaticResource StringToBoolConverter}}"
                       HorizontalOptions="Center" />

                <!-- Sign In button -->
                <Button Text="Sign In"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- ── Footer: Register link ──────────────────────────── -->
            <HorizontalStackLayout Grid.Row="2"
                                   HorizontalOptions="Center"
                                   Spacing="4"
                                   Margin="0,24,0,0">
                <Label Text="Don't have an account?"
                       VerticalOptions="Center"
                       TextColor="Gray" />
                <Button Text="Register"
                        Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryGreen}"
                        FontAttributes="Bold"
                        Padding="0" />
            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
