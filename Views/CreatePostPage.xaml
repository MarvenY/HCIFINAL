<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Le2me.ViewModels"
             x:Class="Le2me.Views.CreatePostPage"
             Title="Add Post">

    <ContentPage.BindingContext>
        <vm:CreatePostViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <Label Text="Share a Recipe"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryGreen}" />

            <!-- ── Image URL ──────────────────────────────────── -->
            <Label Text="Image URL (optional)" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Entry Text="{Binding ImageUrl}"
                       Placeholder="https://…"
                       Keyboard="Url"
                       Style="{StaticResource FormEntry}" />
            </Frame>

            <!-- Preview -->
            <Image Source="{Binding ImageUrl}"
                   HeightRequest="180"
                   Aspect="AspectFill"
                   IsVisible="{Binding ImageUrl, Converter={x:StaticResource StringToBoolConverter}}" />

            <!-- ── Title ──────────────────────────────────────── -->
            <Label Text="Recipe Title *" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Entry Text="{Binding Title}"
                       Placeholder="e.g. Avocado Toast"
                       Style="{StaticResource FormEntry}" />
            </Frame>

            <!-- ── Content ────────────────────────────────────── -->
            <Label Text="Recipe Content *" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,8" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Editor Text="{Binding Content}"
                        Placeholder="Describe your recipe…"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100"
                        FontSize="15" />
            </Frame>

            <!-- ── Calories ───────────────────────────────────── -->
            <Label Text="Calories (optional)" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Entry Text="{Binding Calories}"
                       Placeholder="e.g. 350"
                       Keyboard="Numeric"
                       Style="{StaticResource FormEntry}" />
            </Frame>

            <!-- ── Cooking Time ───────────────────────────────── -->
            <Label Text="Cooking Time (optional)" FontSize="13" TextColor="Gray" />
            <Frame Padding="12,0" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="False">
                <Entry Text="{Binding CookingTime}"
                       Placeholder="e.g. 30 min"
                       Style="{StaticResource FormEntry}" />
            </Frame>

            <!-- ── Error/Success messages ─────────────────────── -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={x:StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center" />

            <Label Text="{Binding SuccessMessage}"
                   TextColor="{StaticResource PrimaryGreen}"
                   FontSize="14"
                   FontAttributes="Bold"
                   IsVisible="{Binding SuccessMessage, Converter={x:StaticResource StringToBoolConverter}}"
                   HorizontalOptions="Center" />

            <!-- ── AI Generate button ─────────────────────────── -->
            <Button Text="✨ Need Help? Generate with AI"
                    Command="{Binding GenerateRecipeDetailsCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#00BCD4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="15" />

            <!-- ── Post button ────────────────────────────────── -->
            <Button Text="Post Recipe"
                    Command="{Binding SubmitPostCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButton}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryGreen}"
                               HorizontalOptions="Center" />

            <BoxView HeightRequest="40" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
